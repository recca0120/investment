{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PriceIndex",
  "$defs": {
    "PriceIndex": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "currency": {
                "type": "string",
                "enum": [
                  "TWD",
                  "USD"
                ],
                "description": "幣別：台股 TWD、美股 USD"
              },
              "first": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "日期（YYYY-MM-DD）"
              },
              "last": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "日期（YYYY-MM-DD）"
              }
            },
            "required": [
              "symbol",
              "currency",
              "first",
              "last"
            ],
            "additionalProperties": false,
            "title": "PriceIndexEntry"
          }
        }
      },
      "required": [
        "symbols"
      ],
      "additionalProperties": false,
      "title": "PriceIndex",
      "description": "網站回測器的代號清單（public/data/prices/index.json）"
    }
  }
}
