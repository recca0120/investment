---
// 首頁：知識文章的建議閱讀順序（檔名本身就是順序，所以用編號）
// docs、base 可以用 props 傳入（Vitest 裡 getCollection() 讀不到資料、BASE_URL 固定是 '/'）
import { getCollection } from 'astro:content';

interface Doc {
  id: string;
  title: string;
  description?: string;
}
interface Props {
  docs?: Doc[];
  base?: string;
}
const props = Astro.props;
const docs: Doc[] =
  props.docs ?? (await getCollection('docs')).map((d) => ({ id: d.id, title: d.data.title, description: d.data.description }));
const base = (props.base ?? import.meta.env.BASE_URL).replace(/\/$/, '');
const knowledge = docs.filter((d) => d.id.startsWith('knowledge/')).sort((a, b) => a.id.localeCompare(b.id));
const decisions = docs.filter((d) => d.id.startsWith('decisions/')).sort((a, b) => a.id.localeCompare(b.id));
// 討論紀錄：新的在前（檔名以日期開頭）
const logs = docs.filter((d) => d.id.startsWith('log/')).sort((a, b) => b.id.localeCompare(a.id));

const heading = 'mt-12 mb-0 text-h3 font-black text-heading';
const link = 'font-bold text-heading no-underline hover:underline hover:decoration-mark hover:underline-offset-4';
---

<section class="reading not-content" aria-labelledby="reading-title">
  <h2 id="reading-title" class={heading}>建議閱讀順序</h2>
  <ol class="mt-4 list-none p-0">
    {
      knowledge.map((d, i) => (
        <li class="m-0 flex items-start gap-4 border-b border-rule py-4">
          {/* 閱讀順序是真的有先後，所以用編號；做成金幣，和撲滿呼應 */}
          <span
            class="grid size-8 shrink-0 place-items-center rounded-full bg-coin text-sm font-black text-coin-ink shadow-coin"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div>
            <a class={link} href={`${base}/${d.id}/`}>{d.title}</a>
            {d.description && <p class="mt-1 mb-0 text-sm text-muted">{d.description}</p>}
          </div>
        </li>
      ))
    }
  </ol>
  <h2 class={heading}>做過的決定</h2>
  <ul class="mt-3 pl-5">
    {
      decisions.map((d) => (
        <li class="my-1.5">
          <a class={link} href={`${base}/${d.id}/`}>{d.title}</a>
        </li>
      ))
    }
  </ul>
  <h2 class={heading}>討論紀錄</h2>
  <ul class="mt-3 pl-5">
    {
      logs.map((d) => (
        <li class="my-1.5">
          <a class={link} href={`${base}/${d.id}/`}>{d.title}</a>
        </li>
      ))
    }
  </ul>
</section>
