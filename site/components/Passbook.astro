---
// 首頁主視覺：用真實回測結果做成一頁「0050 定期定額存摺」
// 資料由 scripts/export_passbook.py 產生；data、base 可以用 props 傳入（測試用）
// 樣式只用 utility class，顏色 token 定義在 site/styles/global.css
import passbook from '../data/passbook.json';

interface Props {
  data?: typeof passbook;
  /** 網站 base，例如 '/investment/'（Vitest 裡 BASE_URL 固定是 '/'，所以要能從外面傳） */
  base?: string;
}
const { data = passbook, base: siteBase = import.meta.env.BASE_URL } = Astro.props;
const n = (v: number) => v.toLocaleString('zh-TW', { maximumFractionDigits: 0 });
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
const rows = data.rows;
const last = rows[rows.length - 1];
const base = siteBase.replace(/\/$/, '');

// 每一格共用：固定列高像存摺格線；第 2 欄（存入）在窄螢幕隱藏
const cell = 'h-9.5 border-b border-rule px-1.5 whitespace-nowrap';
const deposit = 'max-xs:hidden';
---

<figure
  class="passbook not-content m-0 rounded border border-rule bg-paper-raised px-5 pt-5 pb-4 text-ink tabular-nums max-xs:px-3 max-xs:pt-4 max-xs:pb-3"
  aria-labelledby="passbook-caption"
>
  <figcaption id="passbook-caption" class="flex flex-wrap justify-between gap-x-4 gap-y-1 border-b-2 border-ink pb-2.5">
    <span class="text-lg font-black">{data.symbol} 定期定額存摺</span>
    <span class="self-end text-muted">每月 {n(data.monthly)} 元，{data.start.slice(0, 4)} 年起</span>
  </figcaption>
  <table class="m-0 table w-full border-collapse text-sm">
    <thead class="text-muted">
      <tr>
        <th scope="col" class:list={[cell, 'text-left font-normal']}>日期</th>
        <th scope="col" class:list={[cell, deposit, 'text-right font-normal']}>存入</th>
        <th scope="col" class:list={[cell, 'text-right font-normal']}>累計存入</th>
        <th scope="col" class:list={[cell, 'text-right font-normal']}>結餘（市值）</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.slice(0, -1).map((r) => (
          <tr>
            <td class:list={[cell, 'text-left']}>{r.date}</td>
            <td class:list={[cell, deposit, 'text-right']}>{n(r.deposit ?? 0)}</td>
            <td class:list={[cell, 'text-right']}>{n(r.invested)}</td>
            <td class:list={[cell, 'text-right']}>{n(r.value)}</td>
          </tr>
        ))
      }
      <tr class="font-bold [&>td]:border-t-2 [&>td]:border-b-0 [&>td]:border-t-ink">
        <td class:list={[cell, 'text-left']}>{last.date}</td>
        <td class:list={[cell, deposit, 'text-right']}>—</td>
        <td class:list={[cell, 'text-right']}>{n(last.invested)}</td>
        <td class:list={[cell, 'relative pr-17 text-right text-lg font-black']}>
          {n(last.value)}
          <span
            class="absolute top-1/2 right-0.5 grid size-13.5 -translate-y-1/2 -rotate-8 place-items-center rounded-md bg-seal text-xs leading-tight font-black tracking-widest text-seal-ink opacity-92 shadow-seal animate-stamp motion-reduce:animate-none"
            aria-label="印章：含息再投入"
          >
            <span class="block">含息</span><span class="block">再投</span>
          </span>
        </td>
      </tr>
    </tbody>
  </table>
  <p class="mt-3 mb-0 text-xs leading-relaxed text-muted">
    共存入 {data.months} 個月，年化報酬 {pct(data.annualized)}，期間最大跌幅 {pct(data.maxDrawdown)}。
    每年只列一月，歷史報酬不代表未來。<a class="text-link" href={`${base}/knowledge/07-dca-backtest-2016-2026/`}>看完整回測</a>
  </p>
</figure>
